# LLM: any OpenAI-compatible endpoint (vLLM on the AMD box, or a hosted provider for laptop dev)
LLM_BASE_URL=http://localhost:8001/v1
LLM_MODEL=your-served-model-name
LLM_API_KEY=sk-local
# json_schema | function_calling | json_mode (what your server supports for structured output)
LLM_STRUCTURED_METHOD=json_schema

# Mocks: 1 = fake instant results (no GPU / no LLM needed)
ML_MOCK=1
LLM_MOCK=0

# Paths
DATA_DIR=./data
RUNS_DIR=./runs

# auto | cuda (ROCm) | mps | cpu
DEVICE=auto

# Research budgets
BUDGET_PROFILE=research
MIN_BUDGET_S=60
MAX_BUDGET_S=900
FULL_TRAIN_MULTIPLIER=5
MAX_EXPERIMENTS=20
RESEARCH_BUDGET_S=7200
PLATEAU_N=6
