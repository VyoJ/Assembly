# LLM: AMD Token Factory (OpenAI-compatible; see docs/Token-Factory.md). One key for the whole team.
LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
LLM_MODEL=DeepSeek-V4-Flash
LLM_API_KEY=rc-...
# json_schema | function_calling | json_mode (Token Factory: json_schema only on MiMo -> function_calling)
LLM_STRUCTURED_METHOD=function_calling
LLM_MAX_TOKENS=16384
# LLM_REASONING_EFFORT=low
LLM_MAX_CONCURRENCY=3

# Hide streams / label sources with no working ML path yet (comma-separated ids)
# CATALOG_EXCLUDE=line3.cam_top,qc_inspections

# Mocks: 1 = fake instant results (no GPU / no LLM needed)
ML_MOCK=1
LLM_MOCK=0

# Paths
DATA_DIR=./data
RUNS_DIR=./runs

# auto | cuda (ROCm) | mps | cpu
DEVICE=auto

# Research budgets
BUDGET_PROFILE=research
MIN_BUDGET_S=60
MAX_BUDGET_S=900
FULL_TRAIN_MULTIPLIER=5
MAX_EXPERIMENTS=20
RESEARCH_BUDGET_S=7200
PLATEAU_N=6
